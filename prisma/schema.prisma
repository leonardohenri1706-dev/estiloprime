datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  price       Decimal          @db.Decimal(10, 2)
  category    Category
  isActive    Boolean          @default(true)
  images      ProductImage[]
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  isCover   Boolean  @default(false)
  order     Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id         String      @id @default(cuid())
  size       String
  color      String?
  stock      Int         @default(0)
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
}

model DeliveryZone {
  id       String  @id @default(cuid())
  location String
  fee      Decimal @default(0.00) @db.Decimal(10, 2)
  isActive Boolean @default(true)
}

model StoreSetting {
  id             String  @id @default(cuid())
  whatsappNumber String
  pixKey         String?
  pixKeyType     String?
  pixName        String?
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerName  String
  customerPhone String
  deliveryType  String
  deliveryFee   Decimal     @default(0.00) @db.Decimal(10, 2)
  totalAmount   Decimal     @db.Decimal(10, 2)
  status        OrderStatus @default(PENDING)
  notes         String?
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Decimal        @db.Decimal(10, 2)
}

enum Category {
  POLOS
  CAMISETAS
  BERMUDAS
  CONJUNTOS
  ACESSORIOS
}

enum OrderStatus {
  PENDING
  PREPARING
  DELIVERED
  CANCELLED
}
