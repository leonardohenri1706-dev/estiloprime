      {/* 5. CATÁLOGO */}
      <section id="catalogo" className="py-14 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
        
        <div className="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
          <div>
            <div className="inline-flex items-center gap-2 text-xs font-mono font-bold text-[#dfb744] uppercase tracking-widest mb-1">
              <ShoppingBag className="w-4 h-4" /> ARARA DIGITAL ESTILO PRIME
            </div>
            <h2 className="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white uppercase">
              Catálogo Masculino
            </h2>
            <p className="text-neutral-400 text-xs sm:text-sm mt-1">
              Escolha suas peças masculinas, selecione o tamanho e feche no WhatsApp com entrega grátis em Itaiçaba.
            </p>
          </div>

          <div className="relative w-full md:w-80">
            <Search className="w-4 h-4 text-neutral-400 absolute left-3.5 top-1/2 -translate-y-1/2" />
            <input
              type="text"
              placeholder="Buscar polo masculina, oversized..."
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              className="w-full pl-10 pr-4 py-2.5 rounded-xl bg-neutral-900/80 border border-white/[0.08] text-white text-xs placeholder:text-neutral-500 focus:outline-none focus:border-[#c59b27]"
            />
          </div>
        </div>

        <div className="flex items-center gap-2 overflow-x-auto pb-4 mb-4 scrollbar-none">
          {[
            { id: "todos", label: "Todas as Peças" },
            { id: "polos", label: "Polos Tech (Zíper)" },
            { id: "oversized", label: "Streetwear Oversized" },
            { id: "basicas", label: "Básicas & Slim" },
            { id: "bermudas", label: "Bermudas Masculinas" },
            { id: "acessorios", label: "Acessórios" },
          ].map((cat) => (
            <button
              key={cat.id}
              onClick={() => setSelectedCategory(cat.id)}
              className={`px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider whitespace-nowrap transition-all font-heading ${
                selectedCategory === cat.id
                  ? "bg-[#c59b27] text-black"
                  : "bg-neutral-900 border border-white/[0.08] text-neutral-300 hover:text-white"
              }`}
            >
              {cat.label}
            </button>
          ))}
        </div>

        <div className="flex items-center gap-2 mb-8 text-xs font-medium text-neutral-400 flex-wrap">
          <span className="flex items-center gap-1 font-mono">
            <Filter className="w-3.5 h-3.5" /> Grade:
          </span>
          {["all", "P", "M", "G", "GG", "38", "40", "42", "44"].map((size) => (
            <button
              key={size}
              onClick={() => setSelectedSizeFilter(size)}
              className={`px-2.5 py-1 rounded-md text-xs font-bold font-mono transition-all ${
                selectedSizeFilter === size
                  ? "bg-white/[0.08] text-[#dfb744] border border-white/[0.1]"
                  : "bg-neutral-900 text-neutral-300 border border-white/[0.06] hover:border-white/[0.15]"
              }`}
            >
              {size === "all" ? "Todos" : size}
            </button>
          ))}
        </div>

        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6">
          {filteredProducts.map((product) => {
            const defaultSize = product.sizes[0] || "M";
            return (
              <div
                key={product.id}
                className="rounded-2xl glass-card p-3 sm:p-4 transition-all duration-300 hover:-translate-y-1 group flex flex-col justify-between"
              >
                <div
                  className="relative w-full h-64 sm:h-72 lg:h-80 rounded-xl overflow-hidden bg-neutral-900 cursor-pointer mb-3 sm:mb-4"
                  onClick={() => handleOpenQuickView(product)}
                >
                  <img
                    src={product.image}
                    alt={product.name}
                    className="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 filter brightness-95"
                  />
                  <div className="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent" />
                  
                  <div className="absolute top-2.5 left-2.5 px-2 py-0.5 sm:px-2.5 sm:py-1 rounded bg-black/80 border border-white/10 text-[9px] sm:text-[10px] font-mono font-bold text-[#dfb744] uppercase">
                    {product.badge}
                  </div>

                  <div className="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity">
                    <span className="px-3.5 py-2 rounded-xl btn-matte-gold text-black text-xs font-heading font-extrabold uppercase flex items-center gap-1.5">
                      <Eye className="w-4 h-4" /> Ver Caimento
                    </span>
                  </div>

                  <div className="absolute bottom-2.5 left-2.5 flex items-center gap-1">
                    {product.sizes.map((s) => (
                      <span
                        key={s}
                        className="px-1.5 py-0.5 rounded bg-black/70 border border-white/10 text-[9px] font-mono text-neutral-300"
                      >
                        {s}
                      </span>
                    ))}
                  </div>
                </div>

                <div className="space-y-1.5 sm:space-y-2">
                  <div className="flex items-center justify-between text-[10px] sm:text-[11px] font-mono text-neutral-400">
                    <span>{product.categoryName}</span>
                    <span className="text-emerald-400 font-semibold">Frete Grátis</span>
                  </div>

                  <h3 className="font-heading text-sm sm:text-base font-bold text-white line-clamp-1 group-hover:text-[#dfb744] transition-colors uppercase">
                    {product.name}
                  </h3>

                  <div className="flex items-baseline gap-2 pt-1 font-mono">
                    <span className="text-base sm:text-lg font-bold text-white">
                      R$ {product.price.toFixed(2).replace(".", ",")}
                    </span>
                    <span className="text-[11px] sm:text-xs text-neutral-500 line-through">
                      R$ {product.oldPrice.toFixed(2).replace(".", ",")}
                    </span>
                  </div>
                </div>

                <div className="pt-3 sm:pt-4 border-t border-white/[0.06] mt-3 flex items-center gap-2">
                  <button
                    onClick={() => addToCart(product, defaultSize)}
                    className="flex-1 py-2 sm:py-2.5 rounded-xl btn-matte-gold text-black font-heading font-extrabold text-xs uppercase tracking-wider flex items-center justify-center gap-1"
                  >
                    <Plus className="w-3.5 h-3.5" /> Add ({defaultSize})
                  </button>
                  <button
                    onClick={() => handleOpenQuickView(product)}
                    className="p-2 sm:p-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-neutral-300 hover:text-white border border-white/[0.06]"
                  >
                    <Maximize2 className="w-4 h-4" />
                  </button>
                </div>
              </div>
            );
          })}
        </div>

      </section>

      {/* 6. LOOKBOOK */}
