                />
                <div className="absolute inset-0 bg-gradient-to-t from-[#0e0f12] via-[#0e0f12]/30 to-transparent" />
              </div>
              <div className="p-5 text-left">
                <span className="text-[10px] font-mono text-neutral-400 font-bold uppercase">LOOK 02 • STREETWEAR BOXY</span>
                <h4 className="font-heading text-lg font-bold text-white mt-1 uppercase">Camiseta Oversized + Bermuda Moletom</h4>
                <p className="text-xs text-neutral-300 mt-1">A presença marcante das golas grossas caneladas e ombros caídos 240g/m².</p>
              </div>
            </div>

            <div className="rounded-2xl overflow-hidden glass-card group">
              <div className="h-80 sm:h-96 overflow-hidden relative">
                <img
                  src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=800&q=80"
                  alt="Look Resort Linho Masculino"
                  className="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 filter brightness-90"
                />
                <div className="absolute inset-0 bg-gradient-to-t from-[#0e0f12] via-[#0e0f12]/30 to-transparent" />
              </div>
              <div className="p-5 text-left">
                <span className="text-[10px] font-mono text-[#dfb744] font-bold uppercase">LOOK 03 • SUMMER RESORT</span>
                <h4 className="font-heading text-lg font-bold text-white mt-1 uppercase">Polo Areia + Bermuda Linho Puro</h4>
                <p className="text-xs text-neutral-300 mt-1">Frescor e sofisticação natural com linho misto de alto padrão.</p>
              </div>
            </div>
          </div>

        </div>
      </section>

      {/* 7. CONCEPT STORE STORY */}
      <section id="concept-store" className="py-14 sm:py-20 bg-[#08080a] border-t border-white/[0.06] w-full">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="rounded-3xl glass-card p-6 sm:p-10 lg:p-12 border border-white/[0.08]">
            <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
              <div className="lg:col-span-7 space-y-4">
                <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.05] text-[#dfb744] font-mono text-xs font-bold border border-white/[0.08]">
                  <MapPin className="w-3.5 h-3.5" /> MODA MASCULINA EM ITAIÇABA - CE
                </div>
                <h2 className="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white uppercase leading-tight">
                  Da arara física para a comanda digital.
                </h2>
                <p className="text-neutral-300 text-xs sm:text-sm leading-relaxed">
                  A <strong>Estilo Prime</strong> é referência regional em vestuário masculino. Criamos um sistema direto no WhatsApp para você pedir suas peças sem complicação, com taxa zero de entrega em Itaiçaba e atendimento personalizado.
                </p>
                <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 pt-4">
                  <div className="p-4 rounded-xl bg-black/40 border border-white/[0.04]">
                    <span className="font-mono text-[#dfb744] font-bold text-sm block mb-1">01. Escolha</span>
                    <span className="text-xs text-neutral-300">Navegue pelas fotos reais dos looks masculinos.</span>
                  </div>
                  <div className="p-4 rounded-xl bg-black/40 border border-white/[0.04]">
                    <span className="font-mono text-[#dfb744] font-bold text-sm block mb-1">02. Comanda</span>
                    <span className="text-xs text-neutral-300">Gere o pedido formatado com taxa zero.</span>
                  </div>
                  <div className="p-4 rounded-xl bg-black/40 border border-white/[0.04]">
                    <span className="font-mono text-[#dfb744] font-bold text-sm block mb-1">03. Receba</span>
                    <span className="text-xs text-neutral-300">Despacho expresso no seu endereço.</span>
                  </div>
                </div>
              </div>

              <div className="lg:col-span-5 flex flex-col items-center justify-center p-6 sm:p-8 rounded-2xl bg-neutral-950/80 border border-white/[0.08] text-center space-y-4">
                <div className="w-16 h-16 rounded-2xl bg-neutral-900 border border-white/[0.1] flex items-center justify-center text-[#dfb744] font-heading font-black text-2xl">
                  EP
                </div>
                <div>
                  <h4 className="font-heading text-lg font-bold text-white uppercase">Estilo Prime Store</h4>
                  <p className="text-xs text-neutral-400">Moda Masculina &amp; Streetwear • Itaiçaba - CE</p>
                  <p className="text-xs font-mono text-[#dfb744] mt-1">@estiloprime.store</p>
                </div>
                <a
                  href="https://www.instagram.com/estiloprime.store/"
                  target="_blank"
                  rel="noopener noreferrer"
                  className="w-full py-2.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.08] text-xs font-semibold text-white flex items-center justify-center gap-2"
                >
                  <Instagram className="w-4 h-4 text-pink-400" />
                  <span>Seguir no Instagram</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* 8. FOOTER */}
      <footer className="bg-[#08080a] border-t border-white/[0.06] py-12 px-4 sm:px-6 lg:px-8 text-neutral-400 text-xs w-full">
        <div className="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
          <div className="flex items-center gap-3">
            <div className="w-8 h-8 rounded-lg bg-neutral-900 border border-white/[0.1] flex items-center justify-center text-[#dfb744] font-bold text-xs font-heading">
              EP
            </div>
            <div>
              <span className="font-heading font-bold text-sm text-white block uppercase">ESTILO PRIME DIGITAL</span>
              <span className="text-[11px] text-neutral-500 font-mono">Exclusivamente Moda Masculina &amp; Streetwear • Itaiçaba - CE</span>
            </div>
          </div>

          <div className="flex items-center gap-6 font-medium">
            <a href="#hero-slider" className="hover:text-[#dfb744]">Início</a>
            <a href="#catalogo" className="hover:text-[#dfb744]">Catálogo</a>
            <a href="#lookbook" className="hover:text-[#dfb744]">Lookbook</a>
            <button onClick={() => setIsAdminOpen(true)} className="hover:text-[#dfb744] flex items-center gap-1 font-mono">
              <Lock className="w-3 h-3" /> Painel Lojista
            </button>
          </div>

          <div className="text-[11px] text-neutral-500 font-mono">
            © 2026 Estilo Prime Store. Todos os direitos reservados.
          </div>
        </div>
      </footer>

      {/* QUICK VIEW MODAL */}
      {quickViewProduct && (
        <div className="fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4 sm:p-6 overflow-y-auto">
          <div className="relative w-full max-w-4xl rounded-3xl glass-navbar border border-white/[0.12] overflow-hidden shadow-2xl my-auto">
            <button
              onClick={() => setQuickViewProduct(null)}
              className="absolute top-4 right-4 z-20 w-9 h-9 rounded-full bg-black/70 hover:bg-black text-neutral-400 hover:text-white flex items-center justify-center border border-white/10"
            >
              <X className="w-5 h-5" />
            </button>

            <div className="grid grid-cols-1 md:grid-cols-12 gap-6 p-6 sm:p-8">
              <div className="md:col-span-6">
                <div className="relative w-full h-80 sm:h-96 rounded-2xl overflow-hidden bg-neutral-900 border border-white/10">
                  <img
                    src={quickViewProduct.image}
                    alt={quickViewProduct.name}
                    className="w-full h-full object-cover object-center filter brightness-90"
                  />
                  <div className="absolute top-3 left-3 px-2.5 py-1 rounded bg-black/80 border border-white/10 text-[10px] font-mono font-bold text-[#dfb744] uppercase">
                    {quickViewProduct.badge}
                  </div>
                </div>
              </div>

              <div className="md:col-span-6 flex flex-col justify-between space-y-5 text-left">
                <div>
                  <span className="text-xs font-mono text-[#dfb744] font-bold uppercase tracking-wider block mb-1">
                    {quickViewProduct.categoryName} • MENSWEAR
                  </span>
                  <h3 className="font-heading text-2xl sm:text-3xl font-extrabold text-white uppercase">
                    {quickViewProduct.name}
                  </h3>
                  <div className="flex items-baseline gap-3 mt-2 mb-4">
                    <span className="text-2xl sm:text-3xl font-extrabold text-[#dfb744] font-mono">
                      R$ {quickViewProduct.price.toFixed(2).replace(".", ",")}
                    </span>
                    <span className="text-xs text-neutral-500 line-through font-mono">
                      R$ {quickViewProduct.oldPrice.toFixed(2).replace(".", ",")}
                    </span>
                    <span className="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                      EM ESTOQUE
                    </span>
                  </div>

                  <p className="text-xs sm:text-sm text-neutral-300 leading-relaxed mb-6">
                    {quickViewProduct.description}
                  </p>

                  <div className="space-y-2 mb-6">
                    <span className="text-xs font-bold text-neutral-300 font-mono">Grade Masculina:</span>
                    <div className="flex items-center gap-2 flex-wrap">
                      {quickViewProduct.sizes.map((s) => (
                        <button
                          key={s}
                          onClick={() => setQuickViewSize(s)}
                          className={`px-3.5 py-1.5 rounded-lg border text-xs font-mono transition-all ${
                            quickViewSize === s
                              ? "btn-matte-gold text-black font-extrabold"
                              : "bg-neutral-900 text-white border-white/[0.08]"
                          }`}
                        >
                          {s}
                        </button>
                      ))}
                    </div>
                  </div>

                  <div className="p-3 rounded-xl bg-white/[0.04] border border-white/[0.08] flex items-center gap-3 text-xs text-neutral-300">
                    <Truck className="w-5 h-5 text-[#dfb744] flex-shrink-0" />
                    <span><strong>Entrega Grátis em Itaiçaba (R$ 0,00)</strong> ou retirada no balcão.</span>
                  </div>
                </div>

                <div className="pt-4 border-t border-white/[0.08]">
                  <button
                    onClick={() => {
                      addToCart(quickViewProduct, quickViewSize);
                      setQuickViewProduct(null);
                      setIsCartOpen(true);
                    }}
                    className="w-full py-3.5 rounded-xl btn-matte-gold font-heading font-extrabold text-xs uppercase tracking-wider flex items-center justify-center gap-2 shadow-lg"
                  >
                    <ShoppingBag className="w-4 h-4 text-black" />
                    <span>Adicionar à Comanda ({quickViewSize})</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* CARRINHO DRAWER */}
      {isCartOpen && (
        <div className="fixed inset-0 z-50 bg-black/75 backdrop-blur-md flex justify-end">
          <div className="w-full max-w-md bg-[#0e0f12] border-l border-white/[0.08] shadow-2xl flex flex-col justify-between animate-in slide-in-from-right duration-200">
            
            <div className="p-5 border-b border-white/[0.08] flex items-center justify-between bg-black/40">
              <div className="flex items-center gap-2.5">
                <div className="w-8 h-8 rounded-lg bg-white/[0.05] border border-white/[0.08] flex items-center justify-center text-[#dfb744]">
                  <ShoppingBag className="w-4 h-4" />
                </div>
                <div>
                  <h3 className="font-heading text-base font-bold text-white uppercase">Comanda Digital</h3>
                  <span className="text-[11px] text-neutral-400 font-mono">Moda Masculina • Estilo Prime</span>
                </div>
              </div>
              <button
                onClick={() => setIsCartOpen(false)}
                className="w-8 h-8 rounded-lg bg-neutral-800/60 text-neutral-400 hover:text-white flex items-center justify-center"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            <div className="flex-1 overflow-y-auto p-5 space-y-3">
              {cart.length === 0 ? (
                <div className="h-64 flex flex-col items-center justify-center text-center text-neutral-400 space-y-3 font-mono">
                  <ShoppingBag className="w-12 h-12 text-neutral-600" />
                  <p className="text-sm font-bold text-white font-heading uppercase">Sua comanda está vazia</p>
                  <p className="text-xs text-neutral-400">Adicione peças da coleção masculina para fechar o pedido.</p>
                </div>
              ) : (
                cart.map((item, idx) => (
                  <div
                    key={`${item.id}-${item.size}`}
                    className="p-3 rounded-2xl bg-neutral-950/80 border border-white/[0.06] flex items-center justify-between gap-3"
                  >
                    <img
                      src={item.image}
                      alt={item.name}
                      className="w-16 h-16 rounded-xl object-cover object-center border border-white/[0.08]"
                    />
                    <div className="flex-1 min-w-0">
                      <h4 className="text-xs font-bold text-white truncate font-heading uppercase">{item.name}</h4>
                      <div className="text-[11px] font-mono text-[#dfb744] mt-0.5">
                        Tam: <strong>{item.size}</strong> • R$ {item.price.toFixed(2).replace(".", ",")}
                      </div>
                      <div className="flex items-center gap-2 mt-2">
                        <button
                          onClick={() => updateCartQty(idx, -1)}
                          className="w-6 h-6 rounded bg-neutral-800 text-neutral-300 hover:text-white flex items-center justify-center font-mono font-bold text-xs"
                        >
                          -
                        </button>
                        <span className="font-mono text-xs text-white font-bold">{item.quantity}</span>
                        <button
                          onClick={() => updateCartQty(idx, 1)}
                          className="w-6 h-6 rounded bg-neutral-800 text-neutral-300 hover:text-white flex items-center justify-center font-mono font-bold text-xs"
                        >
                          +
                        </button>
                      </div>
                    </div>
                    <div className="text-right font-mono">
                      <span className="text-xs font-bold text-white block">
                        R$ {(item.price * item.quantity).toFixed(2).replace(".", ",")}
                      </span>
                      <button
                        onClick={() => removeCartItem(idx)}
                        className="text-neutral-500 hover:text-red-400 text-[10px] mt-2 flex items-center gap-0.5 justify-end"
                      >
                        <Trash2 className="w-3 h-3" /> Remover
                      </button>
                    </div>
                  </div>
                ))
              )}
            </div>

            {cart.length > 0 && (
              <div className="p-5 border-t border-white/[0.08] bg-black/60 space-y-4">
                <div className="space-y-2">
                  <span className="text-xs font-mono font-bold text-neutral-300 block">Identificação para a Comanda:</span>
                  <input
                    type="text"
                    placeholder="Seu Nome Completo *"
                    value={customerName}
                    onChange={(e) => setCustomerName(e.target.value)}
                    className="w-full px-3.5 py-2 rounded-xl bg-neutral-900 border border-white/[0.08] text-white text-xs placeholder:text-neutral-500 focus:outline-none focus:border-[#c59b27]"
                  />
                  <input
                    type="tel"
                    placeholder="WhatsApp com DDD (Ex: 88 99876-5432) *"
                    value={customerPhone}
                    onChange={(e) => setCustomerPhone(e.target.value)}
                    className="w-full px-3.5 py-2 rounded-xl bg-neutral-900 border border-white/[0.08] text-white text-xs placeholder:text-neutral-500 focus:outline-none focus:border-[#c59b27]"
                  />
                </div>

                <div className="space-y-1.5">
                  <span className="text-xs font-mono font-bold text-neutral-300 block">Local de Entrega:</span>
                  <select
                    value={selectedDelivery}
                    onChange={(e) => setSelectedDelivery(e.target.value)}
                    className="w-full px-3 py-2 rounded-xl bg-neutral-900 border border-white/[0.08] text-neutral-200 text-xs font-semibold focus:outline-none focus:border-[#c59b27]"
                  >
                    {DELIVERY_OPTIONS.map((opt) => (
                      <option key={opt.id} value={opt.id}>
                        {opt.label}
                      </option>
                    ))}
                  </select>
                </div>

                <div className="space-y-1 text-xs border-t border-white/[0.08] pt-3">
                  <div className="flex justify-between text-neutral-400 font-mono">
                    <span>Subtotal:</span>
                    <span className="text-white">R$ {cartSubtotal.toFixed(2).replace(".", ",")}</span>
                  </div>
                  <div className="flex justify-between text-neutral-400 font-mono">
                    <span>Taxa de Entrega:</span>
                    <span className="text-emerald-400 font-bold">
                      {currentDeliveryFee === 0 ? "GRÁTIS (R$ 0,00)" : `R$ ${currentDeliveryFee.toFixed(2).replace(".", ",")}`}
                    </span>
                  </div>
                  <div className="flex justify-between text-sm font-bold text-white pt-1">
                    <span className="font-heading uppercase">Total da Comanda:</span>
                    <span className="font-mono text-[#dfb744] text-base font-bold">
                      R$ {cartTotal.toFixed(2).replace(".", ",")}
                    </span>
                  </div>
                </div>

                <button
                  onClick={handleGenerateComanda}
                  className="w-full py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-heading font-extrabold text-xs uppercase tracking-wider flex items-center justify-center gap-2 shadow-md"
                >
                  <MessageCircle className="w-4 h-4" />
                  <span>Gerar Comanda &amp; Enviar no WhatsApp</span>
                </button>
              </div>
            )}

          </div>
        </div>
      )}

      {/* MODAL DE SUCESSO */}
      {orderModalOpen && generatedOrder && (
        <div className="fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4 sm:p-6 overflow-y-auto">
          <div className="relative w-full max-w-lg rounded-3xl glass-navbar border border-white/[0.12] p-6 sm:p-8 text-center shadow-2xl">
            <div className="w-14 h-14 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 flex items-center justify-center mx-auto mb-4 animate-bounce">
              <Check className="w-7 h-7" />
            </div>

            <span className="text-xs font-mono text-emerald-400 font-bold uppercase block mb-1">
              COMANDA REGISTRADA COM SUCESSO!
            </span>
            <h3 className="font-heading text-3xl font-extrabold text-white">
              {generatedOrder.id}
            </h3>

            <p className="text-xs text-neutral-300 mt-2 mb-6">
              Sua comanda de moda masculina foi gerada. Copie a chave Pix abaixo e envie o comprovante no WhatsApp da loja.
            </p>

            <div className="p-4 rounded-xl bg-black/80 border border-white/[0.08] text-left font-mono text-[11px] text-neutral-300 space-y-2 mb-6 whitespace-pre-line select-all">
              {generatedOrder.text}
            </div>

            <div className="p-4 rounded-2xl bg-white/[0.04] border border-white/[0.08] text-left space-y-2 mb-6">
              <div className="flex items-center justify-between text-xs">
                <span className="font-bold text-[#dfb744] font-mono">Chave Pix (Estilo Prime):</span>
                <span className="text-[10px] text-neutral-400 font-mono">Banco / CNPJ</span>
              </div>
              <div className="flex items-center gap-2">
                <input
                  type="text"
                  readOnly
                  value="88999999999"
                  className="w-full px-3 py-1.5 rounded-lg bg-black/60 border border-white/[0.1] text-[#dfb744] text-xs font-mono select-all"
                />
                <button
                  onClick={copyPixKey}
                  className="px-3 py-1.5 rounded-lg btn-matte-gold text-black font-bold text-xs flex items-center gap-1 flex-shrink-0 font-mono"
                >
                  <Copy className="w-3.5 h-3.5" />
                  <span>{copiedPix ? "Copiado!" : "Copiar"}</span>
                </button>
              </div>
            </div>

            <div className="space-y-2.5">
              <a
                href={generatedOrder.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                className="w-full py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-heading font-extrabold text-xs uppercase tracking-wider flex items-center justify-center gap-2 shadow-lg"
              >
                <Send className="w-4 h-4" />
                <span>Abrir WhatsApp com a Comanda</span>
              </a>
              <button
                onClick={() => setOrderModalOpen(false)}
                className="w-full py-2.5 rounded-xl bg-neutral-900 hover:bg-neutral-800 text-neutral-300 text-xs font-medium font-mono"
              >
                Fechar e Continuar Navegando
              </button>
            </div>
          </div>
        </div>
      )}

      {/* PAINEL LOJISTA */}
      {isAdminOpen && (
        <div className="fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4 sm:p-6 overflow-y-auto">
          <div className="relative w-full max-w-5xl rounded-3xl glass-navbar border border-white/[0.12] p-6 sm:p-8 shadow-2xl my-auto">
            <div className="flex items-center justify-between border-b border-white/[0.08] pb-5 mb-6">
              <div className="flex items-center gap-3">
                <div className="w-10 h-10 rounded-xl bg-white/[0.05] border border-white/[0.1] flex items-center justify-center text-[#dfb744] font-bold">
                  <Shield className="w-5 h-5" />
                </div>
                <div>
                  <h3 className="font-heading text-xl font-bold text-white uppercase">Painel do Lojista — Estilo Prime</h3>
                  <span className="text-xs font-mono text-neutral-400">Controle de Estoque &amp; Catálogo Masculino</span>
                </div>
              </div>
              <button
                onClick={() => setIsAdminOpen(false)}
                className="w-8 h-8 rounded-lg bg-neutral-800 text-neutral-400 hover:text-white flex items-center justify-center"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            <div className="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
              <div className="p-4 rounded-2xl bg-black/40 border border-white/[0.06]">
                <span className="text-[10px] text-neutral-400 uppercase font-mono block">Faturamento Hoje</span>
                <span className="text-xl font-bold text-[#dfb744] font-mono">R$ 1.489,20</span>
              </div>
              <div className="p-4 rounded-2xl bg-black/40 border border-white/[0.06]">
                <span className="text-[10px] text-neutral-400 uppercase font-mono block">Comandas WhatsApp</span>
                <span className="text-xl font-bold text-white font-mono">18 pedidos</span>
              </div>
              <div className="p-4 rounded-2xl bg-black/40 border border-white/[0.06]">
                <span className="text-[10px] text-neutral-400 uppercase font-mono block">Conversão</span>
                <span className="text-xl font-bold text-emerald-400 font-mono">42.5%</span>
              </div>
              <div className="p-4 rounded-2xl bg-black/40 border border-white/[0.06]">
                <span className="text-[10px] text-neutral-400 uppercase font-mono block">Frete Itaiçaba</span>
                <span className="text-xl font-bold text-neutral-200 font-mono">R$ 0,00</span>
              </div>
            </div>

            <div className="space-y-6">
              <div className="overflow-x-auto rounded-xl border border-white/[0.08]">
                <table className="w-full text-left text-xs text-neutral-300">
                  <thead className="bg-neutral-900/80 text-neutral-400 uppercase font-mono text-[10px] border-b border-white/[0.08]">
                    <tr>
                      <th className="p-3">Peça Masculina</th>
                      <th className="p-3">Categoria</th>
                      <th className="p-3">Preço</th>
                      <th className="p-3 text-center">Grade P</th>
                      <th className="p-3 text-center">Grade M</th>
                      <th className="p-3 text-center">Grade G</th>
                      <th className="p-3 text-center">Grade GG</th>
                      <th className="p-3 text-right">Status</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-white/[0.04] bg-black/40 font-mono">
                    {products.map((prod) => (
                      <tr key={prod.id}>
                        <td className="p-3 font-semibold text-white flex items-center gap-2">
                          <img src={prod.image} alt={prod.name} className="w-8 h-8 rounded object-cover object-center" />
                          <span className="truncate max-w-[180px] font-heading uppercase">{prod.name}</span>
                        </td>
                        <td className="p-3 text-neutral-400">{prod.categoryName}</td>
                        <td className="p-3 font-mono text-[#dfb744] font-bold">R$ {prod.price.toFixed(2).replace(".", ",")}</td>
                        <td className="p-3 text-center">{prod.stock.P || 0}</td>
                        <td className="p-3 text-center">{prod.stock.M || 0}</td>
                        <td className="p-3 text-center">{prod.stock.G || 0}</td>
                        <td className="p-3 text-center">{prod.stock.GG || 0}</td>
                        <td className="p-3 text-right">
                          <span className="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 text-[10px] font-bold">
                            Ativo
                          </span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <div className="p-5 rounded-2xl bg-neutral-950 border border-white/[0.08] space-y-4">
                <h4 className="text-xs font-bold text-[#dfb744] uppercase tracking-wider flex items-center gap-1.5 font-heading">
                  <PlusCircle className="w-4 h-4" /> Cadastrar Nova Peça Masculina no Balcão
                </h4>
                <div className="grid grid-cols-1 sm:grid-cols-4 gap-3">
                  <input
                    type="text"
                    placeholder="Nome da Peça (Ex: Polo Tech Off-White)"
                    value={newProdName}
                    onChange={(e) => setNewProdName(e.target.value)}
                    className="px-3 py-2 rounded-xl bg-black border border-white/[0.08] text-white text-xs"
                  />
                  <select
                    value={newProdCat}
                    onChange={(e) => setNewProdCat(e.target.value)}
                    className="px-3 py-2 rounded-xl bg-black border border-white/[0.08] text-white text-xs"
                  >
                    <option value="polos">Polos Tech</option>
                    <option value="oversized">Oversized Streetwear</option>
                    <option value="basicas">Básicas &amp; Slim</option>
                    <option value="bermudas">Bermudas Masculinas</option>
                    <option value="acessorios">Acessórios</option>
                  </select>
                  <input
                    type="number"
                    step="0.10"
                    placeholder="Preço (Ex: 89.90)"
                    value={newProdPrice}
                    onChange={(e) => setNewProdPrice(e.target.value)}
                    className="px-3 py-2 rounded-xl bg-black border border-white/[0.08] text-white text-xs"
                  />
                  <button
                    onClick={handleAdminAddProduct}
                    className="py-2 rounded-xl btn-matte-gold text-black font-bold text-xs font-heading uppercase"
                  >
                    Publicar
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

    </div>
  );
}
