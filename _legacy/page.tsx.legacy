const DELIVERY_OPTIONS = [
  { id: "itaiçaba", label: "🛵 Entrega em Itaiçaba — GRÁTIS", fee: 0 },
  { id: "balcao", label: "🏪 Retirada no Balcão da Loja — GRÁTIS", fee: 0 },
  { id: "jaguaruana", label: "📍 Jaguaruana — R$ 15,00", fee: 15 },
  { id: "russas", label: "📍 Russas — R$ 20,00", fee: 20 },
  { id: "palhano", label: "📍 Palhano — R$ 15,00", fee: 15 },
  { id: "aracati", label: "📍 Aracati — R$ 25,00", fee: 25 },
];

export default function EstiloPrimePage() {
  const [products, setProducts] = useState<Product[]>(INITIAL_PRODUCTS);
  const [cart, setCart] = useState<CartItem[]>([]);
  const [isCartOpen, setIsCartOpen] = useState(false);
  const [selectedCategory, setSelectedCategory] = useState("todos");
  const [selectedSizeFilter, setSelectedSizeFilter] = useState("all");
  const [searchQuery, setSearchQuery] = useState("");

  const [currentSlide, setCurrentSlide] = useState(0);
  const [isSliderHovered, setIsSliderHovered] = useState(false);

  const [quickViewProduct, setQuickViewProduct] = useState<Product | null>(null);
  const [quickViewSize, setQuickViewSize] = useState<string>("M");

  const [customerName, setCustomerName] = useState("");
  const [customerPhone, setCustomerPhone] = useState("");
  const [selectedDelivery, setSelectedDelivery] = useState("itaiçaba");
  const [orderModalOpen, setOrderModalOpen] = useState(false);
  const [generatedOrder, setGeneratedOrder] = useState<{
    id: string;
    text: string;
    whatsappUrl: string;
    total: number;
  } | null>(null);
  const [copiedPix, setCopiedPix] = useState(false);

  const [isAdminOpen, setIsAdminOpen] = useState(false);
  const [newProdName, setNewProdName] = useState("");
  const [newProdCat, setNewProdCat] = useState("polos");
  const [newProdPrice, setNewProdPrice] = useState("");

  useEffect(() => {
    if (isSliderHovered) return;
    const timer = setInterval(() => {
      setCurrentSlide((prev) => (prev + 1) % HERO_SLIDES.length);
    }, 5500);
    return () => clearInterval(timer);
  }, [isSliderHovered]);

  const activeSlide = HERO_SLIDES[currentSlide];

  const filteredProducts = useMemo(() => {
    return products.filter((p) => {
      const matchCat =
        selectedCategory === "todos" || p.category === selectedCategory;
      const matchSize =
        selectedSizeFilter === "all" || p.sizes.includes(selectedSizeFilter);
      const query = searchQuery.toLowerCase().trim();
      const matchSearch =
        !query ||
        p.name.toLowerCase().includes(query) ||
        p.description.toLowerCase().includes(query) ||
        p.categoryName.toLowerCase().includes(query);
      return matchCat && matchSize && matchSearch;
    });
  }, [products, selectedCategory, selectedSizeFilter, searchQuery]);

  const cartSubtotal = useMemo(() => {
    return cart.reduce((acc, item) => acc + item.price * item.quantity, 0);
  }, [cart]);

  const currentDeliveryFee = useMemo(() => {
    const option = DELIVERY_OPTIONS.find((d) => d.id === selectedDelivery);
    return option ? option.fee : 0;
  }, [selectedDelivery]);

  const cartTotal = cartSubtotal + currentDeliveryFee;
  const cartItemCount = cart.reduce((acc, item) => acc + item.quantity, 0);

  const addToCart = (product: Product, size: string) => {
    setCart((prev) => {
      const existing = prev.find(
        (item) => item.id === product.id && item.size === size
      );
      if (existing) {
        return prev.map((item) =>
          item.id === product.id && item.size === size
            ? { ...item, quantity: item.quantity + 1 }
            : item
        );
      }
      return [
        ...prev,
        {
          id: product.id,
          name: product.name,
          price: product.price,
          image: product.image,
          size: size,
          quantity: 1,
        },
      ];
    });

    confetti({
      particleCount: 25,
      spread: 50,
      origin: { y: 0.85 },
      colors: ["#c59b27", "#dfb744", "#ffffff"],
    });
  };

  const updateCartQty = (index: number, delta: number) => {
    setCart((prev) => {
      const item = prev[index];
      if (!item) return prev;
      const newQty = item.quantity + delta;
      if (newQty <= 0) {
        return prev.filter((_, i) => i !== index);
      }
      return prev.map((it, i) =>
        i === index ? { ...it, quantity: newQty } : it
      );
    });
  };

  const removeCartItem = (index: number) => {
    setCart((prev) => prev.filter((_, i) => i !== index));
  };

  const handleOpenQuickView = (product: Product) => {
    setQuickViewProduct(product);
    setQuickViewSize(product.sizes[0] || "M");
  };

  const handleGenerateComanda = () => {
    if (cart.length === 0) return;

    const cName = customerName.trim() || "Cliente Estilo Prime";
    const cPhone = customerPhone.trim() || "(88) 99876-5432";
    const deliveryOpt =
      DELIVERY_OPTIONS.find((d) => d.id === selectedDelivery) ||
      DELIVERY_OPTIONS[0];

    const orderNum = `#EP-${Math.floor(1000 + Math.random() * 9000)}`;
    const now = new Date();
    const dateStr = `${now.toLocaleDateString("pt-BR")} às ${now.toLocaleTimeString(
      "pt-BR",
      { hour: "2-digit", minute: "2-digit" }
    )}`;

    const itemsStr = cart
      .map(
        (item) =>
          `• ${item.quantity}x ${item.name} (Tamanho: ${item.size}) — R$ ${(
            item.price * item.quantity
          )
            .toFixed(2)
            .replace(".", ",")}`
      )
      .join("\n");

    const deliveryFormatted =
      deliveryOpt.fee === 0
        ? "Entrega em Itaiçaba — GRÁTIS (R$ 0,00)"
        : `${deliveryOpt.label.replace(/📍|🛵|🏪/g, "").trim()}`;

    const comandaText = `📋 *COMANDA DE PEDIDO — ESTILO PRIME*
━━━━━━━━━━━━━━━━━━━━━
*Pedido:* ${orderNum}
*Cliente:* ${cName} (${cPhone})
*Data:* ${dateStr}
━━━━━━━━━━━━━━━━━━━━━
🛍️ *ITENS DO PEDIDO (MODA MASCULINA):*
${itemsStr}
━━━━━━━━━━━━━━━━━━━━━
🛵 *FORMA DE RECEBIMENTO:*
${deliveryFormatted}
━━━━━━━━━━━━━━━━━━━━━
💰 *VALOR TOTAL: R$ ${cartTotal.toFixed(2).replace(".", ",")}*
*Chave Pix:* 88999999999 (Estilo Prime)
━━━━━━━━━━━━━━━━━━━━━
🔗 *Acompanhe seu pedido:*
https://estiloprime.store/pedido/${orderNum.replace("#", "").toLowerCase()}`;

    const whatsappUrl = `https://wa.me/5588999999999?text=${encodeURIComponent(
      comandaText
    )}`;

    setGeneratedOrder({
      id: orderNum,
      text: comandaText,
      whatsappUrl: whatsappUrl,
      total: cartTotal,
    });

    setIsCartOpen(false);
    setOrderModalOpen(true);
    setCart([]);

    confetti({
      particleCount: 60,
      spread: 80,
      origin: { y: 0.6 },
      colors: ["#c59b27", "#dfb744", "#ffffff"],
    });
  };

  const copyPixKey = () => {
    navigator.clipboard.writeText("88999999999").then(() => {
      setCopiedPix(true);
      setTimeout(() => setCopiedPix(false), 2500);
    });
  };

  const handleAdminAddProduct = () => {
    if (!newProdName || !newProdPrice) return;
    const priceNum = parseFloat(newProdPrice);
    if (isNaN(priceNum)) return;

    const catMap: Record<string, string> = {
      polos: "Polo Tech Smart Casual",
      oversized: "Streetwear Oversized",
      basicas: "Básicas & Slim Fit",
      bermudas: "Bermudas Masculinas",
      acessorios: "Acessórios Masculinos",
    };

    const newProd: Product = {
      id: Date.now(),
      name: `${newProdName} Masculina`,
      category: newProdCat,
      categoryName: catMap[newProdCat] || "Moda Masculina",
      price: priceNum,
      oldPrice: priceNum * 1.25,
      badge: "NOVIDADE",
      description:
        "Nova peça masculina recém-chegada na arara da Estilo Prime. Qualidade extrema, corte masculino exclusivo e durabilidade superior.",
      image:
        "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=900&q=80",
      sizes: ["P", "M", "G", "GG"],
      stock: { P: 3, M: 5, G: 4, GG: 2 },
    };

    setProducts((prev) => [newProd, ...prev]);
    setNewProdName("");
    setNewProdPrice("");
  };

  return (
    <div className="bg-[#08080a] text-[#f2f2f5] min-h-screen antialiased flex flex-col justify-between w-full bg-grain">
      
      {/* 1. TOP ANNOUNCEMENT BAR */}
      <div className="bg-[#0e0f12]/95 border-b border-white/[0.06] text-xs py-2 px-3 sm:px-4 text-center sticky top-0 z-50 w-full backdrop-blur-md">
        <div className="max-w-7xl mx-auto flex items-center justify-between gap-2 sm:gap-4 text-[11px] sm:text-xs">
          <div className="hidden md:flex items-center gap-2 text-neutral-400 font-mono">
            <span className="w-1.5 h-1.5 rounded-full bg-emerald-500" />
            <span className="uppercase tracking-widest text-[10px] font-semibold text-neutral-300">ESTILO PRIME • MENSWEAR</span>
          </div>
          
          <div className="flex items-center justify-center gap-2 mx-auto md:mx-0">
            <span className="px-2 py-0.5 rounded bg-white/[0.06] text-[#dfb744] font-mono font-bold text-[10px] uppercase border border-white/[0.08]">
              ITAIÇABA - CE
            </span>
            <span className="text-neutral-300 truncate">
              Entrega Grátis na cidade <strong>(R$ 0,00)</strong> • Fechamento direto no WhatsApp
            </span>
          </div>

          <div className="hidden lg:flex items-center gap-4 text-neutral-400 font-mono text-[11px]">
            <a href="https://www.instagram.com/estiloprime.store/" target="_blank" rel="noopener noreferrer" className="hover:text-[#dfb744] flex items-center gap-1.5 transition-colors">
              <Instagram className="w-3.5 h-3.5 text-neutral-400" /> @estiloprime.store
            </a>
          </div>
        </div>
      </div>

      {/* 2. NAVBAR COM ULTRA BLUR */}
      <header className="sticky top-8 z-40 px-3 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
        <div className="glass-navbar rounded-2xl sm:rounded-3xl h-18 sm:h-20 px-4 sm:px-6 flex items-center justify-between border border-white/[0.08] shadow-2xl my-2">
          
          <a href="#" className="flex items-center gap-3 group cursor-pointer">
            <div className="w-10 h-10 rounded-xl bg-neutral-900 border border-white/[0.1] flex items-center justify-center group-hover:border-[#c59b27]/60 transition-colors flex-shrink-0">
              <svg viewBox="0 0 44 44" className="w-6 h-6 text-[#dfb744] fill-current">
                <path d="M7 15 L14 26 L22 13 L30 26 L37 15 L35 31 L9 31 Z" fill="#c59b27" />
                <circle cx="22" cy="11" r="2.5" fill="#dfb744" />
                <circle cx="7" cy="13" r="2" fill="#dfb744" />
                <circle cx="37" cy="13" r="2" fill="#dfb744" />
                <rect x="9" y="32.5" width="26" height="2.5" rx="1" fill="#dfb744" />
              </svg>
            </div>
            <div>
              <div className="flex items-center gap-1.5">
                <span className="font-heading font-extrabold text-lg sm:text-xl tracking-tight text-white group-hover:text-[#dfb744] transition-colors">
                  ESTILO PRIME
                </span>
                <span className="text-[9px] font-mono font-bold px-1.5 py-0.2 rounded bg-white/[0.06] text-neutral-300 border border-white/[0.08]">
                  MEN
                </span>
              </div>
              <span className="text-[9px] font-mono text-neutral-400 tracking-wider block">
                @estiloprime.store • Itaiçaba
              </span>
            </div>
          </a>

          <nav className="hidden lg:flex items-center gap-1 px-3 py-1.5 rounded-full bg-black/40 border border-white/[0.06] text-xs font-semibold uppercase tracking-wider text-neutral-300">
            <a href="#hero-slider" className="px-3.5 py-1.5 rounded-full hover:bg-white/[0.08] hover:text-white transition-all flex items-center gap-1.5">
              <Sparkles className="w-3.5 h-3.5 text-[#dfb744]" /> Destaques
            </a>
            <a href="#colecoes" className="px-3.5 py-1.5 rounded-full hover:bg-white/[0.08] hover:text-white transition-all">
              Coleções
            </a>
            <a href="#catalogo" className="px-3.5 py-1.5 rounded-full hover:bg-white/[0.08] hover:text-white transition-all">
              Catálogo
            </a>
            <a href="#lookbook" className="px-3.5 py-1.5 rounded-full hover:bg-white/[0.08] hover:text-white transition-all">
              Lookbook
            </a>
            <a href="#concept-store" className="px-3.5 py-1.5 rounded-full hover:bg-white/[0.08] hover:text-white transition-all">
              A Loja
            </a>
          </nav>

          <div className="flex items-center gap-2 sm:gap-3">
            <button onClick={() => setIsAdminOpen(true)} className="hidden sm:flex items-center gap-1.5 px-3 py-2 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.06] text-xs text-neutral-400 hover:text-white font-mono">
              <Shield className="w-3.5 h-3.5" />
              <span>Admin</span>
            </button>

            <button
              onClick={() => setIsCartOpen(true)}
              className="relative flex items-center gap-2 px-4 py-2.5 rounded-xl btn-matte-gold font-bold text-xs uppercase tracking-wider shadow-md"
            >
              <ShoppingBag className="w-4 h-4 text-black" />
              <span className="hidden sm:inline font-heading font-extrabold text-black">Comanda</span>
              <span className="w-5 h-5 rounded-full bg-black text-[#dfb744] text-[11px] font-mono font-bold flex items-center justify-center">
                {cartItemCount}
              </span>
            </button>
          </div>

        </div>
      </header>

      {/* 3. HERO SLIDER COM TIPOGRAFIA SYNE */}
      <section
        id="hero-slider"
        className="relative min-h-[75vh] sm:min-h-[85vh] lg:min-h-[88vh] flex items-center justify-center overflow-hidden bg-[#08080a] w-full mt-2"
        onMouseEnter={() => setIsSliderHovered(true)}
        onMouseLeave={() => setIsSliderHovered(false)}
      >
        <div className="absolute inset-0 w-full h-full overflow-hidden">
          {HERO_SLIDES.map((slide, idx) => (
            <div
              key={idx}
              className={`absolute inset-0 transition-opacity duration-1000 ease-out ${
                idx === currentSlide ? "opacity-100 scale-100" : "opacity-0 scale-102"
              }`}
            >
              <img
                src={slide.image}
                alt={slide.titlePrefix}
                className="w-full h-full object-cover object-center filter brightness-[0.68] transition-transform duration-1000"
              />
              <div className="absolute inset-0 bg-gradient-to-r from-[#08080a]/95 via-[#08080a]/60 to-transparent" />
              <div className="absolute inset-0 bg-gradient-to-t from-[#08080a] via-transparent to-black/40" />
            </div>
          ))}
        </div>

        <div className="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 relative z-20 py-12 sm:py-16">
          <div className="max-w-2xl text-left space-y-4 sm:space-y-5 animate-in fade-in duration-500">
            
            <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.05] border border-white/[0.08] text-[10px] sm:text-[11px] font-mono tracking-widest text-[#dfb744] uppercase">
              <span className="w-1.5 h-1.5 rounded-full bg-[#c59b27]" />
              <span>{activeSlide.badge}</span>
            </div>

            <h1 className="font-heading text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.04] uppercase">
              {activeSlide.titlePrefix} <br />
              <span className="text-[#dfb744]">
                {activeSlide.titleHighlight}
              </span>
              <br />{activeSlide.titleSuffix}
            </h1>

            <p className="text-neutral-300 text-xs sm:text-sm lg:text-base max-w-lg leading-relaxed font-normal">
              {activeSlide.desc}
            </p>

            <div className="flex flex-wrap items-center gap-3 sm:gap-4 pt-2">
              <a
                href="#catalogo"
                onClick={() => setSelectedCategory(activeSlide.category)}
                className="px-6 sm:px-7 py-3 sm:py-3.5 rounded-xl btn-matte-gold text-black font-heading font-extrabold text-xs uppercase tracking-wider flex items-center justify-center gap-2 group shadow-md"
              >
                <span>{activeSlide.cta}</span>
                <ArrowDownRight className="w-4 h-4 group-hover:translate-x-0.5 group-hover:translate-y-0.5 transition-transform" />
              </a>

              <a
                href="#lookbook"
                className="px-5 sm:px-6 py-3 sm:py-3.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.08] text-neutral-200 font-semibold text-xs flex items-center justify-center gap-2 backdrop-blur-md"
              >
                <Camera className="w-4 h-4 text-[#dfb744]" />
                <span>Ver Lookbook</span>
              </a>
            </div>

            <div className="flex items-center gap-4 pt-4 sm:pt-6 font-mono text-xs text-neutral-400">
              <span className="font-bold text-[#dfb744]">
                0{currentSlide + 1}
              </span>
              <div className="w-28 sm:w-36 h-1 bg-white/[0.1] rounded-full overflow-hidden relative">
                <div
                  className="h-full bg-[#c59b27] rounded-full transition-all duration-300"
                  style={{
                    width: `${((currentSlide + 1) / HERO_SLIDES.length) * 100}%`,
                  }}
                />
              </div>
              <span>0{HERO_SLIDES.length}</span>
            </div>

          </div>
        </div>

        <div className="absolute bottom-6 right-4 sm:bottom-8 sm:right-8 z-30 flex items-center gap-2 sm:gap-3">
          <button
            onClick={() =>
              setCurrentSlide((prev) => (prev - 1 + HERO_SLIDES.length) % HERO_SLIDES.length)
            }
            className="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-black/60 hover:bg-black/80 border border-white/[0.1] text-neutral-300 hover:text-white flex items-center justify-center backdrop-blur-md"
          >
            <ChevronLeft className="w-5 h-5" />
          </button>
          <button
            onClick={() =>
              setCurrentSlide((prev) => (prev + 1) % HERO_SLIDES.length)
            }
            className="w-10 h-10 sm:w-11 sm:h-11 rounded-xl btn-matte-gold flex items-center justify-center font-bold"
          >
            <ChevronRight className="w-5 h-5 text-black" />
          </button>
        </div>

      </section>

      {/* 4. COLEÇÕES MASCULINAS */}
      <section id="colecoes" className="py-14 sm:py-20 bg-[#0e0f12] border-y border-white/[0.06] w-full">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          
          <div className="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
            <div>
              <span className="text-xs font-mono font-bold text-[#dfb744] uppercase tracking-widest block mb-1">
                CURADORIA POR CATEGORIA
              </span>
              <h2 className="font-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white uppercase">
                Coleções de Vestuário Masculino
              </h2>
            </div>
            <p className="text-neutral-400 text-xs sm:text-sm max-w-md">
              Peças estruturadas com foco no caimento corporal masculino, tecidos nobres e durabilidade.
            </p>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
            
            <div
              className="group relative rounded-2xl overflow-hidden glass-card transition-all cursor-pointer"
              onClick={() => setSelectedCategory("polos")}
            >
              <div className="h-80 sm:h-96 overflow-hidden relative">
                <img
                  src="https://images.unsplash.com/photo-1586363104862-3a5e2ab60d99?auto=format&fit=crop&w=800&q=80"
                  alt="Polos Tech Masculinas"
                  className="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 filter brightness-90"
                />
                <div className="absolute inset-0 bg-gradient-to-t from-[#0e0f12] via-[#0e0f12]/40 to-transparent" />
              </div>
              <div className="absolute bottom-5 left-5 right-5 text-left">
                <span className="text-[10px] font-mono text-[#dfb744] font-bold uppercase tracking-widest block mb-1">01. SMART CASUAL</span>
                <h3 className="font-heading text-xl sm:text-2xl font-bold text-white mb-1.5 uppercase">Polos Tech com Zíper</h3>
                <p className="text-neutral-300 text-xs mb-3 line-clamp-2">Malha estruturada com elastano anti-suor e zíper frontal inoxidável.</p>
                <span className="inline-flex items-center gap-1 text-xs font-bold text-[#dfb744] group-hover:translate-x-1 transition-transform">
                  Explorar Polos <ArrowRight className="w-3.5 h-3.5" />
                </span>
              </div>
            </div>

            <div
              className="group relative rounded-2xl overflow-hidden glass-card transition-all cursor-pointer"
