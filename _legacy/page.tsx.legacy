            >
              <div className="h-80 sm:h-96 overflow-hidden relative">
                <img
                  src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=800&q=80"
                  alt="Camisetas Oversized Masculinas"
                  className="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 filter brightness-90"
                />
                <div className="absolute inset-0 bg-gradient-to-t from-[#0e0f12] via-[#0e0f12]/40 to-transparent" />
              </div>
              <div className="absolute bottom-5 left-5 right-5 text-left">
                <span className="text-[10px] font-mono text-neutral-400 font-bold uppercase tracking-widest block mb-1">02. STREETWEAR</span>
                <h3 className="font-heading text-xl sm:text-2xl font-bold text-white mb-1.5 uppercase">Camisetas Oversized Boxy</h3>
                <p className="text-neutral-300 text-xs mb-3 line-clamp-2">Ombros caídos, gola grossa de 3cm e 100% algodão penteado 240g/m².</p>
                <span className="inline-flex items-center gap-1 text-xs font-bold text-[#dfb744] group-hover:translate-x-1 transition-transform">
                  Explorar Oversized <ArrowRight className="w-3.5 h-3.5" />
                </span>
              </div>
            </div>

            <div
              className="group relative rounded-2xl overflow-hidden glass-card transition-all cursor-pointer"
              onClick={() => setSelectedCategory("bermudas")}
            >
              <div className="h-80 sm:h-96 overflow-hidden relative">
                <img
                  src="https://images.unsplash.com/photo-1594938298603-c8148c4dae35?auto=format&fit=crop&w=800&q=80"
                  alt="Bermudas Masculinas Linho e Moletom"
                  className="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 filter brightness-90"
                />
                <div className="absolute inset-0 bg-gradient-to-t from-[#0e0f12] via-[#0e0f12]/40 to-transparent" />
              </div>
              <div className="absolute bottom-5 left-5 right-5 text-left">
                <span className="text-[10px] font-mono text-[#dfb744] font-bold uppercase tracking-widest block mb-1">03. CASUAL RESORT</span>
                <h3 className="font-heading text-xl sm:text-2xl font-bold text-white mb-1.5 uppercase">Bermudas Linho &amp; Moletom</h3>
                <p className="text-neutral-300 text-xs mb-3 line-clamp-2">Corte alfaiataria masculino acima do joelho e cós elástico com cordão ajustável.</p>
                <span className="inline-flex items-center gap-1 text-xs font-bold text-[#dfb744] group-hover:translate-x-1 transition-transform">
                  Explorar Bermudas <ArrowRight className="w-3.5 h-3.5" />
                </span>
              </div>
            </div>

